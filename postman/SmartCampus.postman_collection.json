              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseCode\": \"CS304\",\n  \"courseName\": \"Computer Networks\",\n  \"credits\": 4,\n  \"semester\": 6,\n  \"departmentId\": 1\n}"
            },
            "description": "201 Created. 409 if the course code exists."
          }
        },
        {
          "name": "Get courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "description": "200 OK."
          }
        },
        {
          "name": "Search courses by department",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses/search?department=CSE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses",
                "search"
              ],
              "query": [
                {
                  "key": "department",
                  "value": "CSE"
                }
              ]
            },
            "description": "200 OK."
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Mark attendance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/attendance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 1,\n  \"courseId\": 1,\n  \"date\": \"2026-09-28\",\n  \"status\": \"PRESENT\"\n}"
            },
            "description": "201 Created. Response: {id, studentId, studentCode, studentName, courseId, courseCode, courseName, date, status}. 409 if already marked for that student, course and date."
          }
        },
        {
          "name": "Get all attendance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance"
              ]
            },
            "description": "200 OK. Newest first."
          }
        },
        {
          "name": "Get attendance (paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/page?page=0&size=10&sortBy=attendanceDate&direction=desc&studentId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "page"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "attendanceDate"
                },
                {
                  "key": "direction",
                  "value": "desc"
                },
                {
                  "key": "studentId",
                  "value": "1"
                }
              ]
            },
            "description": "200 OK. Paged response; studentId is optional."
          }
        },
        {
          "name": "Get attendance of a student",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/student/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "student",
                "1"
              ]
            },
            "description": "200 OK. studentId is the numeric database id."
          }
        },
        {
          "name": "Update attendance",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 1,\n  \"courseId\": 1,\n  \"date\": \"2026-09-14\",\n  \"status\": \"ABSENT\"\n}"
            },
            "description": "200 OK."
          }
        },
        {
          "name": "Attendance percentage (one course)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/student/1/course/1/percentage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "student",
                "1",
                "course",
                "1",
                "percentage"
              ]
            },
            "description": "200 OK. Example: {\"studentId\":1,\"courseId\":1,\"attendancePercentage\":100.0}"
          }
        },
        {
          "name": "Attendance summary (all courses)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/student/1/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "student",
                "1",
                "summary"
              ]
            },
            "description": "200 OK. Array of {courseId, courseCode, courseName, totalClasses, presentClasses, absentClasses, percentage}."
          }
        }
      ]
    },
