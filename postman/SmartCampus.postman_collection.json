    {
      "name": "Reports and export",
      "item": [
        {
          "name": "Low attendance students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/low-attendance?threshold=75",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reports",
                "low-attendance"
              ],
              "query": [
                {
                  "key": "threshold",
